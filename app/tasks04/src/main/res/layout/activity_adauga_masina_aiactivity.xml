<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F2FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_manager"
            android:textColor="#6750A4"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/adauga_o_masina"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/completeaza_datele_vehiculului"
            android:textColor="#777777"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:id="@+id/etMarcaAI"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/marca_masinii"
            android:inputType="textCapWords"/>

            <EditText
            android:id="@+id/etPretAI"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/pret_eur"
            android:inputType="numberDecimal"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/categorie"
            android:textStyle="bold"
            android:layout_marginTop="24dp"/>

        <Spinner
            android:id="@+id/spCategorieAI"
            android:layout_width="match_parent"
            android:layout_height="48dp"/>

        <CheckBox
            android:id="@+id/cbElectricaAI"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/masina_electrica"
            android:layout_marginTop="20dp"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchNouaAI"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/masina_noua0"
            android:layout_marginTop="12dp"
            android:checked="false"/>

        <Button
            android:id="@+id/btnSalveazaAI"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/salveaza_masina"
            android:layout_marginTop="32dp"
            android:backgroundTint="#6750A4"/>

    </LinearLayout>
</ScrollView>
